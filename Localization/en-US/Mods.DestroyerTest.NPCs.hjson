	DisplayName: Cursed Flame Node
	InternalName: CursedFlameNode
	BestiaryEntry1:
		'''
		In response to its waning ability to spread, the Corruption, much like its holy counterpart, has taken to defending what land it already has claimed.
		Despite the ferocity with which it attacks, it is an inanimate construct puppeteered by the invisible forces of The Corruption.
		'''

	Fables: {
		Name: Cursed Flame Node
		Title: Defensive Construct
	}
}


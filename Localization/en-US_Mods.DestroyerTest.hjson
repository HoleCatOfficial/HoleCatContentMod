Emotes: {
	ProspectorEmote.Command: prospectoremote
	UntitledEmote.Command: untitledemote
	VampireEmote.Command: vampireemote
}

RecipeCondition: {
	Charge: Charge this item's Husk.
	DefeatNightmareRose: Defeat the Nightmare Rose
	DefeatWyvernCorpse: Defeat Wyvern Corpse
}

UI: {
	LivingShadow: Charge: {0}%
	MeleeImmunity: "{0}%"
}

Infernum.NightmareRoseIntroText: NIGHTMARE ROSE
PitySystem.UsesPity:
	'''
	[i:DestroyerTest/PityMarkBig] This item implements a pity system.
	[i:DestroyerTest/PityMarkBig] Opening the bag multiple times increases the chances of getting rare items from it, and increases the quantity of normal resource drops from it.
	[i:DestroyerTest/PityMarkBig] Successfully getting a rare drop will reset your pity.
	'''
ShieldPlayer.ShieldLine:
	'''
	[i:DestroyerTest/ShieldMarkBig] This item implements a special shield.
	[i:DestroyerTest/ShieldMarkBig] These Shields kill harmful projectiles inside their radius and do not protect from NPC contact damage.
	[i:DestroyerTest/ShieldMarkBig] Shields do not regenerate until they break, and pull from your health to regenerate.
	'''
ModName: Talid Mod (Private Beta)

Extras: {
	ShadeWorldCommonBestiary: In addition to freeing the moon lord from imprisonment, breaking the seal also tore open holes across space, allowing enemies from the shade world to enter yours.
	ShadeWorldRareBestiary: The Shade World is a reflection of your own world, but is forever in the limbo of superposition. Where you stand, a shade equal of you stands in the same place, their molecules occupying the same space.
	ShadeWorldEpicBestiary: Mother Darkness can create a menagerie of creatures unlike what anyone has seen. She can do this day and night for centuries if she wished. Though not even the most spectacular of her creations can match her coveted object of affection, Idri.
}

Conditions: {
	NightmareRoseBossDowned: Defeated Nightmare Rose
	WyvernCorpseBossDowned: Defeated the Wyvern Corpse
	NodeBossDowned: Defeated a Node
	ConstitutionBossDowned: Defeated Constitution
	AnyNodeBossDowned: Mods.DestroyerTest.Conditions.AnyNodeBossDowned
	IchorNodeBossDowned: Mods.DestroyerTest.Conditions.IchorNodeBossDowned
	CursedFlameNodeBossDowned: Mods.DestroyerTest.Conditions.CursedFlameNodeBossDowned
	BlessedNodeBossDowned: Mods.DestroyerTest.Conditions.BlessedNodeBossDowned
	TenebrousConstructBossDowned: Mods.DestroyerTest.Conditions.TenebrousConstructBossDowned
}

Configs: {
	DTConfig: {
		DisplayName: Main Config

		MinionExtrasToggle: {
			Label: Minions Have Extra Effects
			Tooltip: Some minions have extra effects. This disables them.
		}

		EnableDebugMessages: {
			Label: Enable Debug Messages
			Tooltip: Across the mod, there is a variety of debug text used during testing. All of it can be made visible if this is enabled.
		}

		DragCamera: {
			Label: Use Reworked Camera
			Tooltip: Unlocks the camera from the player, making it follow using interpolation. This will interfere with screenshake effects. Enable this to have the intended experience with Talid.
		}

		MinionAmmoReplace: {
			Label: Minions can convert ammunition
			Tooltip: If enabled, Minions like the Blossom Beater will be able to convert bullets into their own bullets. If disabled, the projectile of the bullet will be fired instead.
		}

		WeaponKickback: {
			Label: Weapon Kickback
			Tooltip: Some weapons have kickback effects. Disable this if those interfere with your experience.
		}

		ScepterTileCollsionsCooldown: {
			Label: Scepter Tile Collsion Effects Cooldown
			Tooltip: The minimum amount of time that must pass before a scepter's tile collision effect can activate again.
		}

		ScrollEffectsCooldown: {
			Label: Scroll Effects Cooldown
			Tooltip: The minimum amount of time that must pass before a scroll's effect can activate again.
		}

		BlessingVFX: {
			Label: Blessing V F X
			Tooltip: ""
		}

		ScreenshakeEffects: {
			Label: Screenshake Effects
			Tooltip: ""
		}
	}

	DTMusicConfig: {
		DisplayName: Music Config

		NodeIdleMusic: {
			Label: Nodes have Idle Music
			Tooltip: If enabled, the Node Bosses will play their own music track when dormant and during their waves.
		}

		EternityMusic: {
			Label: Eternity/Death and Maso Music
			Tooltip: Talid's bosses use separate tracks for Eternity/Death and Masochist Mode. Enable this to hear them.
		}

		ReplaceVanillaTracks: {
			Label: Custom tracks
			Tooltip: Some areas, such as the Shimmer and Solar Eclipse, will have their music replaced with custom tracks if this config is enabled.
		}
	}

	DTOptimizationsConfig: {
		DisplayName: Optimizations Config

		OptimizeGame: {
			Label: General Optimizations
			Tooltip: Expensive draw calls, gore spawns, and effects will be disabled if this is enabled.
		}

		DisableExcessDusts: {
			Label: Disable Excess Dusts
			Tooltip: Dusts that exist solely for visuals will not be created.
		}

		DisableExcessParticles: {
			Label: Disable Excess Particles
			Tooltip: Particles that exist solely for visuals will not be created.
		}

		DisableExcessTrails: {
			Label: Disable Excess Trails
			Tooltip: Primitive trails will not draw unless they are required to see something.
		}
	}

	DTUIConfig: {
		DisplayName: UI Config

		RiftBarXPos: {
			Label: Rift Charge Bar X Offset
			Tooltip: ""
		}

		RiftBarYPos: {
			Label: Rift Charge Bar Y Offset
			Tooltip: ""
		}

		NightBarXPos: {
			Label: Night Armor Teleport Cooldown Bar X Offset
			Tooltip: ""
		}

		NightBarYPos: {
			Label: Night Armor Teleport Cooldown Bar Y Offset
			Tooltip: ""
		}

		CustomBossBarScaleModifier: {
			Label: Custom Boss Bar Scale Modifier
			Tooltip: ""
		}
	}
}

DropConditions.EternityMode: Mods.DestroyerTest.DropConditions.EternityMode

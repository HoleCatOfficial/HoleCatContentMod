	RiftGuardChausses: {
		DisplayName: Rift Guard Chausses
		Tooltip:
			'''
			Increases run speed by 22%.
			If charged, increases acceleration by 20%.
			"Oxygen can leak out of it fairly easily."
			'''
	}

	RiftGuardChestPlate: {
		DisplayName: Rift Guard Chestplate
		Tooltip:
			'''
			Increases Ranger critical strike change by 40%.
			This bonus is reduced to 25% if the set bonus is active.
			If charged, you get 6 Ranged armor penetration.
			"Oxygen can leak out of it fairly easily."
			'''
	}

	RiftGuardVisor: {
		DisplayName: Rift Guard Visor
		Tooltip:
			'''
			Increases Ranger damage by 10%; 20% if charged.
			"Oxygen can leak out of it fairly easily."
			'''
		SetBonus:
			'''
			Shooting enemies builds charge up to three tiers.
			Tier 1 increases Ranged Damage by 10% and Ranged Crit chance by 6%.
			Tier 2 increases Ranged Damage by 20% and Ranged Crit chance by 12%.
			Tier 3 increases Ranged Damage by 40% and Ranged Crit chance by 18%, and your weapon will fire clouds of Heliouric Electricity.
			Not using your weapon, or charging to 120 charge on Tier 3 will reset charge.
			'''
	}

	RiftPropulsion: {
		DisplayName: Rift Propulsion
		Tooltip: A device inspired by an alien technology.
	}

	HeliciteChausses: {
		DisplayName: Helicite Chausses
		Tooltip:
			'''
			Despite being made of Cloth, these do not leak any oxygen, and will protect you from suffocation in The Rift.
			The infusion of Helicite into the cloth allows for this to happen. Quite an anomaly, those crystals are...
			'''
	}

	HeliciteCowl: {

	}

	Item_ShadeBossMusicBox: {
		Tooltip: ""
		DisplayName: Shade Boss Music Box
	}

	GodGouger: {
		DisplayName: God Gouger
		Tooltip:
			'''
			A javelin in the image of a gaping, toothy maw, empowered by a god's emotional torment and regret, that splits into two smaller javelins that both home in on enemies.
			Inflicts Soul Erosion on enemies, lowering their attack stat.
			"The Devastation said to have struck Hekate after their loss was so deep and grave that in some notes left in their garden work area, they had written that they would:
			'rather gouge my heart out with a blighted maw than have to live with the baggage of a decision that was never mine to make.'"
			'''
	}

